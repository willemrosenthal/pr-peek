{
  "name": "pr-peek",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=24"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "esbuild",
      "prisma"
    ]
  },
  "scripts": {
    "dev": "pnpm -r --parallel --if-present dev",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose stop",
    "db:migrate": "pnpm --filter @pr-peek/server db:migrate",
    "build": "pnpm -r --if-present build",
    "render:build": "pnpm install --frozen-lockfile --prod=false && pnpm build",
    "lint": "eslint .",
    "lint:workflows": "docker run --rm -v \"$PWD:/repo\" -w /repo rhysd/actionlint:1.7.7",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "test:core": "vitest run --project @pr-peek/core",
    "test:server": "vitest run --project @pr-peek/server",
    "test:web": "vitest run --project @pr-peek/web",
    "e2e": "pnpm --filter @pr-peek/web e2e",
    "desktop": "pnpm --filter @pr-peek/desktop tauri dev",
    "desktop:build": "pnpm --filter @pr-peek/desktop tauri build --bundles app",
    "ios": "pnpm --filter @pr-peek/ios open",
    "ios:sync": "pnpm --filter @pr-peek/ios cap sync ios",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "conventional-changelog-conventionalcommits": "^10.4.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "semantic-release": "^25.0.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
