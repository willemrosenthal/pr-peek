generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Sign in sessions. Read and written by connect-pg-simple, not Prisma.
// Matches its table.sql, so the store and Prisma migrations agree.
model Session {
  sid    String   @id @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
  @@map("session")
}

enum ItemStatus {
  open
  resolved
}

// How the user signed in: the GitHub OAuth App, or a pasted personal access token.
enum AuthMethod {
  oauth
  pat
}

model User {
  id                    String     @id @default(cuid())
  githubId              Int        @unique
  login                 String
  name                  String?
  avatarUrl             String?
  // Unused. Left in place so old servers keep working during a deploy. Drop it later.
  authMethod            AuthMethod @default(oauth)
  // GitHub sign in tokens, encrypted (see crypto.ts). Access tokens expire after about 8 hours.
  accessTokenEnc        String?
  accessTokenExpiresAt  DateTime?
  refreshTokenEnc       String?
  refreshTokenExpiresAt DateTime?
  tokenScopes           String[]
  // A personal access token the user added, encrypted. Syncs use it instead when set.
  patEnc                String?
  patExpiresAt          DateTime?
  patScopes             String[]
  lastSyncedAt          DateTime?
  // "reauth" stops syncs until the user signs in again. Other errors retry after a wait.
  syncError             String?
  // Failed syncs in a row, and when to try again (see sync-schedule.ts).
  syncFailures          Int        @default(0)
  syncRetryAt           DateTime?
  // When the running sync started. Null when none is running.
  syncStartedAt         DateTime?
  // The last time the user opened the app. Idle users sync less often.
  lastActiveAt          DateTime   @default(now())
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  settings          UserSettings?
  watchedRepos      WatchedRepo[]
  pullRequests      PullRequest[]
  items             Item[]
  ruleSettings      RuleSetting[]
  pushSubscriptions PushSubscription[]
  notificationLogs  NotificationLog[]
}

model UserSettings {
  userId              String  @id
  timezone            String  @default("UTC")
  staleWarnHours      Int     @default(4)
  staleLateHours      Int     @default(24)
  workHoursOnly       Boolean @default(false)
  // Times are "HH:MM" in the user's timezone.
  quietStart          String?
  quietEnd            String?
  quietWeekends       Boolean @default(false)
  digestTime          String?
  includeTeamRequests Boolean @default(true)
  hideBots            Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WatchedRepo {
  id           String   @id @default(cuid())
  userId       String
  githubRepoId Int
  owner        String
  name         String
  enabled      Boolean  @default(true)
  muted        Boolean  @default(false)
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, githubRepoId])
}

model PullRequest {
  id              String   @id @default(cuid())
  userId          String
  githubNodeId    String
  githubRepoId    Int
  repoOwner       String
  repoName        String
  number          Int
  title           String
  url             String
  authorLogin     String
  isDraft         Boolean
  state           String
  headSha         String
  checkState      String?
  githubUpdatedAt DateTime
  // The last sync that found this PR. PRs not found for 7 days are deleted.
  lastSeenAt      DateTime @default(now())
  snapshot        Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  items Item[]

  @@unique([userId, githubNodeId])
}

model Item {
  id            String     @id @default(cuid())
  userId        String
  pullRequestId String
  kind          String
  dedupeKey     String
  latestEventId String
  eventCount    Int        @default(1)
  actorLogin    String?
  summary       String
  occurredAt    DateTime
  waitingSince  DateTime?
  status        ItemStatus @default(open)
  resolvedAt    DateTime?
  seenAt        DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  pullRequest      PullRequest       @relation(fields: [pullRequestId], references: [id], onDelete: Cascade)
  notificationLogs NotificationLog[]

  @@unique([userId, dedupeKey])
  @@index([userId, status])
  @@index([pullRequestId])
}

model RuleSetting {
  userId   String
  ruleId   String
  enabled  Boolean  @default(true)
  severity String
  channels String[]
  options  Json     @default("{}")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, ruleId])
}

model PushSubscription {
  id            String    @id @default(cuid())
  userId        String
  endpoint      String    @unique
  p256dh        String
  auth          String
  label         String?
  platform      String?
  lastSuccessAt DateTime?
  failureCount  Int       @default(0)
  createdAt     DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model NotificationLog {
  id      String   @id @default(cuid())
  userId  String
  itemId  String
  // The item's latestEventId when sent, so each event notifies once.
  eventId String
  channel String
  status  String
  sentAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, eventId, channel])
  @@index([userId])
}
