generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Sign in sessions. Read and written by connect-pg-simple, not Prisma.
// Matches its table.sql, so the store and Prisma migrations agree.
model Session {
  sid    String   @id @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
  @@map("session")
}

enum ItemStatus {
  open
  resolved
}

// How the user signed in: the GitHub OAuth App, or a pasted personal access token.
enum AuthMethod {
  oauth
  pat
}

// Why syncs are failing. "reauth" and "token" stop syncs until the user acts. "failed"
// retries after a wait.
enum SyncError {
  reauth
  token
  failed
}

// "open" while the sync tracks a PR. The others say why it stopped.
enum PrState {
  open
  merged
  closed
  gone
  unwatched
}

enum Severity {
  low
  normal
  high
}

enum Channel {
  list
  push
}

// "pending" until the send ends. A crash mid-send leaves it pending, and it isn't sent
// again. "sent" if any device got it.
enum NotificationStatus {
  pending
  sent
  failed
}

model User {
  id                    String     @id @default(cuid())
  githubId              Int        @unique
  login                 String
  name                  String?
  avatarUrl             String?
  // Unused. Left in place so old servers keep working during a deploy. Drop it later.
  authMethod            AuthMethod @default(oauth)
  // GitHub sign in tokens, encrypted (see crypto.ts). Access tokens expire after about 8 hours.
  accessTokenEnc        String?
  accessTokenExpiresAt  DateTime?
  refreshTokenEnc       String?
  refreshTokenExpiresAt DateTime?
  tokenScopes           String[]
  // A personal access token the user added, encrypted. Syncs use it instead when set.
  patEnc                String?
  patExpiresAt          DateTime?
  patScopes             String[]
  lastSyncedAt          DateTime?
  syncError             SyncError?
  // Failed syncs in a row, and when to try again (see sync-schedule.ts).
  syncFailures          Int        @default(0)
  syncRetryAt           DateTime?
  // When the running sync started. Null when none is running.
  syncStartedAt         DateTime?
  // The last time the user opened the app. Idle users sync less often.
  lastActiveAt          DateTime   @default(now())
  // The Mac menu bar app's last heartbeat. Recent means it's running, so it gets
  // notifications instead of the browsers on that Mac.
  desktopSeenAt         DateTime?
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  settings          UserSettings?
  watchedRepos      WatchedRepo[]
  pullRequests      PullRequest[]
  items             Item[]
  ruleSettings      RuleSetting[]
  pushSubscriptions PushSubscription[]
  notificationLogs  NotificationLog[]
}

model UserSettings {
  userId              String  @id
  timezone            String  @default("UTC")
  staleWarnHours      Int     @default(4)
  staleLateHours      Int     @default(24)
  workHoursOnly       Boolean @default(false)
  // Hours between reminders once a review request is red. Null for none.
  remindEveryHours    Int?
  // Times are "HH:MM" in the user's timezone.
  quietStart          String?
  quietEnd            String?
  quietWeekends       Boolean @default(false)
  // High severity notifications still arrive during quiet hours.
  highBreaksQuiet     Boolean @default(false)
  digestTime          String?
  // The user's local date ("YYYY-MM-DD") of the last morning summary, so it goes once a day.
  lastSummaryDate     String?
  includeTeamRequests Boolean @default(true)
  hideBots            Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WatchedRepo {
  id           String   @id @default(cuid())
  userId       String
  githubRepoId Int
  owner        String
  name         String
  enabled      Boolean  @default(true)
  muted        Boolean  @default(false)
  // "#rrggbb" for the repo name on the list. Null keeps the default color.
  color        String?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, githubRepoId])
}

model PullRequest {
  id              String   @id @default(cuid())
  userId          String
  githubNodeId    String
  githubRepoId    Int
  repoOwner       String
  repoName        String
  number          Int
  title           String
  url             String
  authorLogin     String
  isDraft         Boolean
  state           PrState
  headSha         String
  checkState      String?
  githubUpdatedAt DateTime
  // The last sync whose searches found this PR. Deleted after 7 days with no open items.
  lastSeenAt      DateTime @default(now())
  snapshot        Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  items Item[]

  @@unique([userId, githubNodeId])
}

model Item {
  id            String     @id @default(cuid())
  userId        String
  pullRequestId String
  kind          String
  dedupeKey     String
  latestEventId String
  eventCount    Int        @default(1)
  actorLogin    String?
  actorIsBot    Boolean    @default(false)
  summary       String
  occurredAt    DateTime
  waitingSince  DateTime?
  status        ItemStatus @default(open)
  resolvedAt    DateTime?
  seenAt        DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  pullRequest      PullRequest       @relation(fields: [pullRequestId], references: [id], onDelete: Cascade)
  notificationLogs NotificationLog[]

  @@unique([userId, dedupeKey])
  @@index([userId, status])
  @@index([pullRequestId])
}

model RuleSetting {
  userId   String
  ruleId   String
  enabled  Boolean   @default(true)
  severity Severity
  channels Channel[]
  options  Json      @default("{}")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, ruleId])
}

model PushSubscription {
  id            String    @id @default(cuid())
  userId        String
  endpoint      String    @unique
  p256dh        String
  auth          String
  label         String?
  // The lowest severity this device gets.
  minSeverity   Severity  @default(low)
  // A browser on a Mac. Skipped while the menu bar app runs. Null until the browser says.
  onMac         Boolean?
  lastSuccessAt DateTime?
  failureCount  Int       @default(0)
  createdAt     DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model NotificationLog {
  id      String             @id @default(cuid())
  userId  String
  itemId  String
  // The item's latestEventId when sent, so each event notifies once.
  eventId String
  channel Channel
  status  NotificationStatus @default(pending)
  sentAt  DateTime           @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, eventId, channel])
  @@index([userId])
}
