generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Sign in sessions. Read and written by connect-pg-simple, not Prisma.
// Matches its table.sql, so the store and Prisma migrations agree.
model Session {
  sid    String   @id @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
  @@map("session")
}

enum ItemStatus {
  open
  resolved
}

// How the user signed in: the GitHub OAuth App, or a pasted personal access token.
enum AuthMethod {
  oauth
  pat
}

// Admins see the admin page and get its alerts. Set by hand in the database.
enum Role {
  user
  admin
}

// Why syncs are failing. "reauth" and "token" stop syncs until the user acts. "failed"
// retries after a wait.
enum SyncError {
  reauth
  token
  failed
}

// "open" while the sync tracks a PR. The others say why it stopped.
enum PrState {
  open
  merged
  closed
  gone
  unwatched
}

enum Severity {
  low
  normal
  high
}

// Where the list shows PR authors' pictures: nowhere, only under Needs my review, or on
// every row.
enum ShowAuthors {
  off
  review
  all
}

enum Channel {
  list
  push
}

// "pending" until the send ends. A crash mid-send leaves it pending, and it isn't sent
// again. "sent" if any device got it.
enum NotificationStatus {
  pending
  sent
  failed
}

model User {
  id                    String     @id @default(cuid())
  githubId              Int        @unique
  login                 String
  name                  String?
  avatarUrl             String?
  // Unused. Left in place so old servers keep working during a deploy. Drop it later.
  authMethod            AuthMethod @default(oauth)
  // GitHub sign in tokens, encrypted (see crypto.ts). Access tokens expire after about 8 hours.
  accessTokenEnc        String?
  accessTokenExpiresAt  DateTime?
  refreshTokenEnc       String?
  refreshTokenExpiresAt DateTime?
  tokenScopes           String[]
  lastSyncedAt          DateTime?
  syncError             SyncError?
  // Failed syncs in a row, and when to try again (see sync-schedule.ts).
  syncFailures          Int        @default(0)
  syncRetryAt           DateTime?
  // When the running sync started. Null when none is running.
  syncStartedAt         DateTime?
  // The start of the last sync that ran the rules on every PR (a full pass). One runs
  // when this is null, or older than `rulesStaleAt` or the worker's start.
  rulesRunAt            DateTime?
  // When a setting changed what the rules find.
  rulesStaleAt          DateTime?
  // The user's GitHub teams as "org/team-slug", and when they were last checked.
  teams                 String[]   @default([])
  teamsCheckedAt        DateTime?
  // The last time the user opened the app. Idle users sync less often.
  lastActiveAt          DateTime   @default(now())
  // The Mac menu bar app's last heartbeat. Recent means it's running, so it gets
  // notifications instead of the browsers on that Mac.
  desktopSeenAt         DateTime?
  // When the GitHub sign in stopped working while a personal access token still worked.
  // Syncs skip the sign in until the user signs in again, which clears it.
  signInStoppedAt       DateTime?
  role                  Role       @default(user)
  // When an admin approved the sign-up request. Null while it waits: every route but /me
  // answers 403, and nothing syncs. Declining deletes the user.
  approvedAt            DateTime?
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  settings          UserSettings?
  watchedRepos      WatchedRepo[]
  pullRequests      PullRequest[]
  items             Item[]
  ruleSettings      RuleSetting[]
  pushSubscriptions PushSubscription[]
  appleDevices      AppleDevice[]
  notificationLogs  NotificationLog[]
  githubTokens      GitHubToken[]
}

model UserSettings {
  userId              String      @id
  timezone            String      @default("UTC")
  staleWarnHours      Int         @default(4)
  staleLateHours      Int         @default(24)
  workHoursOnly       Boolean     @default(false)
  // Hours between reminders once a review request is red. Null for none.
  remindEveryHours    Int?
  // Times are "HH:MM" in the user's timezone.
  quietStart          String?
  quietEnd            String?
  quietWeekends       Boolean     @default(false)
  // High severity notifications still arrive during quiet hours.
  highBreaksQuiet     Boolean     @default(false)
  digestTime          String?
  // The last quiet hours and summary time set. They stay when those are turned off, so
  // turning them back on brings the user's own times back.
  keptQuietStart      String?
  keptQuietEnd        String?
  keptDigestTime      String?
  // The user's local date ("YYYY-MM-DD") of the last morning summary, so it goes once a day.
  lastSummaryDate     String?
  includeTeamRequests Boolean     @default(true)
  hideBots            Boolean     @default(false)
  showAuthors         ShowAuthors @default(off)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WatchedRepo {
  id           String   @id @default(cuid())
  userId       String
  githubRepoId Int
  owner        String
  name         String
  enabled      Boolean  @default(true)
  muted        Boolean  @default(false)
  // "#rrggbb" for the repo name on the list. Kept while turned off, so it comes back.
  color        String?
  colorOn      Boolean  @default(false)
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, githubRepoId])
}

model PullRequest {
  id               String    @id @default(cuid())
  userId           String
  githubNodeId     String
  githubRepoId     Int
  repoOwner        String
  repoName         String
  number           Int
  title            String
  url              String
  authorLogin      String
  isDraft          Boolean
  state            PrState
  headSha          String
  // The latest commit's runs counted by state (`checksFingerprint`), to notice when its
  // checks change. The column kept its old name.
  checkFingerprint String?   @map("checkState")
  githubUpdatedAt  DateTime
  // The last sync whose searches found this PR. Deleted after 7 days with no open items.
  lastSeenAt       DateTime  @default(now())
  // When the user swiped it to quiet. Cleared when something new happens on it.
  quietAt          DateTime?
  // When the user marked it important, as a reminder. Stays until they unmark it.
  importantAt      DateTime?
  // When the user added it by its link. Tracked whatever its repo, until unflagged.
  addedAt          DateTime?
  // When a sync saw it merged. Important PRs stay on the list after, until unmarked.
  mergedAt         DateTime?
  // When the push saying an important PR merged went out, so it goes once.
  mergeNotifiedAt  DateTime?
  // Worked out from the PR's details when a sync saves them (see sync.ts).
  // The latest real push, so a quiet PR wakes on new commits.
  lastPushSha      String?
  // The list section it shows in with no open items (`ListSection`).
  listGroup        String?
  // What an assigned PR needs next (`AssignedState`).
  assignedState    String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  items Item[]

  @@unique([userId, githubNodeId])
}

model Item {
  id              String     @id @default(cuid())
  userId          String
  pullRequestId   String
  kind            String
  dedupeKey       String
  latestEventId   String
  eventCount      Int        @default(1)
  actorLogin      String?
  actorIsBot      Boolean    @default(false)
  summary         String
  occurredAt      DateTime
  waitingSince    DateTime?
  // A review request the user commented on, until the author asks again.
  waitingOnAuthor Boolean    @default(false)
  // What a review said: "approved" or "changes_requested". "reviewed" items only.
  reviewState     String?
  status          ItemStatus @default(open)
  resolvedAt      DateTime?
  seenAt          DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  pullRequest      PullRequest       @relation(fields: [pullRequestId], references: [id], onDelete: Cascade)
  notificationLogs NotificationLog[]

  @@unique([userId, dedupeKey])
  @@index([userId, status])
  @@index([pullRequestId])
}

model RuleSetting {
  userId   String
  ruleId   String
  enabled  Boolean   @default(true)
  severity Severity
  channels Channel[]
  options  Json      @default("{}")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, ruleId])
}

// The iPhone app's devices, for Apple push (plan 12). Web push devices are PushSubscription.
model AppleDevice {
  id            String    @id @default(cuid())
  userId        String
  // The device token Apple gives the app.
  token         String    @unique
  label         String?
  // An Xcode build, which only Apple's sandbox reaches. TestFlight and App Store builds
  // use the main service.
  sandbox       Boolean   @default(false)
  lastSuccessAt DateTime?
  failureCount  Int       @default(0)
  createdAt     DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PushSubscription {
  id            String    @id @default(cuid())
  userId        String
  endpoint      String    @unique
  p256dh        String
  auth          String
  label         String?
  // A browser on a Mac. Skipped while the menu bar app runs. Null until the browser says.
  onMac         Boolean?
  lastSuccessAt DateTime?
  failureCount  Int       @default(0)
  createdAt     DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum TokenKind {
  classic
  fine_grained
}

enum TokenStatus {
  working
  stopped
}

// A personal access token the user added, for orgs that block our OAuth App. Syncs use
// it instead of the sign in. Plan 20 allows several: a fine-grained one reaches one org.
model GitHubToken {
  id               String      @id @default(cuid())
  userId           String
  name             String
  // Encrypted (see crypto.ts).
  tokenEnc         String
  // SHA-256 of the token, so the same one can't be added twice. This and the kind (from
  // the token's prefix) are null for tokens copied from User.patEnc until they're next
  // read: the copy couldn't decrypt them.
  tokenHash        String?
  kind             TokenKind?
  // Classic tokens list them. Fine-grained ones have none.
  scopes           String[]
  expiresAt        DateTime?
  // The users and orgs whose repos it reaches, and when that was checked.
  owners           String[]    @default([])
  ownersCheckedAt  DateTime?
  status           TokenStatus @default(working)
  stoppedAt        DateTime?
  // When the push 7 days before it expires, and the one when it stopped, went out.
  // Replacing the token clears both.
  expiryRemindedAt DateTime?
  stopRemindedAt   DateTime?
  lastUsedAt       DateTime?
  createdAt        DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tokenHash])
}

model NotificationLog {
  id      String             @id @default(cuid())
  userId  String
  itemId  String
  // The item's latestEventId when sent, so each event notifies once.
  eventId String
  channel Channel
  status  NotificationStatus @default(pending)
  sentAt  DateTime           @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, eventId, channel])
  @@index([userId])
}

// When each alert to the admin last went out, so each goes at most once a day (see
// health.ts).
model AdminAlert {
  kind   String   @id
  sentAt DateTime
}

// Usage counted in memory by each process and saved once an hour (usage.ts), for the
// admin page. A save adds to the row, keeping the lowest `low` and the highest `high`.
model UsageStat {
  // The start of the day or hour counted.
  bucket DateTime
  // "web" or "worker".
  source String
  // What was counted, like "db" or "job", and which one, like "PullRequest select".
  metric String
  key    String
  count  BigInt   @default(0)
  total  BigInt   @default(0)
  low    BigInt?
  high   BigInt?

  @@id([bucket, source, metric, key])
}
