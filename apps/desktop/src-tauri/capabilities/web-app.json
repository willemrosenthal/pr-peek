{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "web-app",
  "description": "Lets the hosted web app, and only it (dev builds add the local dev server in lib.rs), update the tray, open links, hide the app, and restart it into an update.",
  "windows": ["main"],
  "local": false,
  "remote": {
    "urls": ["https://www.git-buddy.com/*"]
  },
  "permissions": [
    "allow-set-tray-state",
    "allow-open-external",
    "allow-hide-window",
    "allow-notify",
    "allow-launch-at-login",
    "allow-set-launch-at-login",
    "allow-pop-out",
    "allow-update-ready",
    "allow-restart-to-update"
  ]
}
