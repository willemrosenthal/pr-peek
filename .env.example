# Copy this file to .env and fill in the values.
# Each plan adds the variables it needs here.

NODE_ENV=development
# The API server's port. Not 3000, so it can run beside other local apps.
PORT=3001
LOG_LEVEL=info

# Public URL of the app. In dev, the Vite server on 5173, which passes /api to Express on PORT.
APP_URL=http://localhost:5173

# Local Postgres from docker-compose.yml (port 5433 so it doesn't clash with other Postgres installs).
DATABASE_URL=postgresql://prpeek:prpeek@localhost:5433/prpeek

# Max database connections per pool (server and worker each have one). Defaults to 5.
# Supabase's session pooler allows about 15 in all on the free plan, so raise it with care.
# DB_POOL_MAX=5

# Syncs the worker runs at once. They share the worker's pool. Defaults to 6.
# SYNC_CONCURRENCY=6

# Generate each with: openssl rand -base64 32
# Use different values in production.
SESSION_SECRET=
TOKEN_ENC_KEY=

# From the "git-buddy (dev)" GitHub OAuth App.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Push notifications. Leave all three empty to turn push off.
# Generate the keys once with: pnpm --filter @pr-peek/server exec web-push generate-vapid-keys
# Use different keys in production, and never change them once set.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A contact for the push services, like mailto:you@example.com.
VAPID_SUBJECT=

# Separate database for tests, so tests never touch your dev data. Created on first test run.
TEST_DATABASE_URL=postgresql://prpeek:prpeek@localhost:5433/prpeek_test
